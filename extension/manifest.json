{
  "manifest_version": 3,
  "name": "Manga Local Translator (GPU CUDA)",
  "version": "1.2.0",
  "description": "Real-time manga translation using a local CUDA GPU inference server with LaMa inpainting and comic typesetting.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "*://*.mangadex.org/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mangadex.org/*",
        "*://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "renderer.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*",
        "styles.css",
        "renderer.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
